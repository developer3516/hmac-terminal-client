      "nonce": "ff00ff00ff00ff00ff00ff00ff00ff00",
      "bodySha256": "ae15e27203c6bd2bc51aef57e354637b4fba09e0db98bbc79915e9064f935f4c",
      "canonicalRequest": "v1\nPOST\n/notes\n\n1767225600\nff00ff00ff00ff00ff00ff00ff00ff00\nae15e27203c6bd2bc51aef57e354637b4fba09e0db98bbc79915e9064f935f4c",
      "signature": "c18b29dbbd97660ca675f565347babfc7515363d89141d6905b45acb4eaeea26"
    },
    {
      "name": "method-lowercase-input",
      "catches": "the method is uppercased before signing",
      "request": {
        "method": "delete",
        "path": "/terminals/T-1",
        "query": null,
        "body": null
      },
      "timestamp": 1767225600,
      "nonce": "ff00ff00ff00ff00ff00ff00ff00ff00",
      "bodySha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "canonicalRequest": "v1\nDELETE\n/terminals/T-1\n\n1767225600\nff00ff00ff00ff00ff00ff00ff00ff00\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "signature": "658d19fb44dcee6a032469dbb105f99963ac1e9b1b4a64eb6ecb34e9f87aac4b"
    },
    {
